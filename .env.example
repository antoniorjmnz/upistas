# Copiar a .env y rellenar. .env nunca se sube a git.
# Una línea por variable; las comentadas llevan el valor por defecto (el que usa src/upistas/config.py).

# LLM (Helmcode, API compatible con OpenAI). Pedir la clave al equipo por privado.
HELMCODE_API_KEY=
HELMCODE_BASE_URL=https://api.helmcode.com/v1
# MODELO_VISION=deepseek-v4-flash      # lee los escaneos
# MODELO_VISION_RESPALDO=gemma4        # si el de visión falla o no responde
# MODELO_TEXTO=glm5.3                  # lee los PDF con texto
# MODELO_NOTAS=glm5.3                  # evalúa las notas de las facturas; por defecto el mismo que MODELO_TEXTO
# NOTAS_TIMEOUT_S=30                   # segundos máximos por evaluación de notas
# VISION_TIMEOUT_S=30                  # segundos máximos por página para que la visión lea un escaneo; si se agota, la factura se escala
# NOTAS_MAX_TOKENS=4096
# LECTURA_TIMEOUT_S=300                # segundos máximos por documento, OCR incluido
# FAL_KEY=                             # solo con --ocr (uv run --extra ocr); clave de Fal, de pago

# OCR de escaneados (--ocr): Firecrawl /parse, sin extras; solo la clave.
# FIRECRAWL_API_KEY=
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# ERP local del reto (make erp en el repo oficial)
ERP_URL=http://127.0.0.1:8009
# ERP_USER=alberto
# ERP_PASSWORD=FACTURAS2009

# Datos
# CAJA_DIR=../caja                     # repo oficial de La Caja clonado
# EXCEL_PATH=                          # maestro; si no, se busca FINAL_v7_DEFINITIVO_ahorasi.xlsx en CAJA_DIR, data/ y la raíz
# ERP_SNAPSHOT=                        # JSON de asientos para usar en vez del ERP HTTP
# ALMACEN_DIR=almacen                  # PDF que suben por la web; no se sube a git

# Fecha de referencia para 'fecha no futura'. Fija = resultados reproducibles.
HOY=2026-09-18

# Una sola base de datos para la app y el pipeline. Por defecto SQLite en la raíz del repo (upistas.sqlite).
# Para escalar (varios procesos): docker compose up -d y
# DATABASE_URL=postgresql://upistas:upistas@localhost:5432/upistas
# CONCURRENCIA=16                      # documentos que se leen a la vez

# Web (Django). En local no hace falta tocar nada.
# DJANGO_SECRET_KEY=                   # obligatoria fuera de desarrollo
# DJANGO_DEBUG=1
# CSRF_TRUSTED_ORIGINS=                # separados por coma, si la web se sirve desde otro dominio
